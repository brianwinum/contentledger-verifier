{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wp-contentledger:schema:transparency-leaf-inventory:1",
  "title": "WP ContentLedger Transparency Leaf Inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["checkpointSha256", "format", "leaves", "version"],
  "properties": {
    "checkpointSha256": { "$ref": "#/$defs/sha256" },
    "format": { "const": "WP ContentLedger Transparency Leaf Inventory" },
    "leaves": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/item" }
    },
    "version": { "const": "1.0" }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leaf", "leafHash", "leafIndex"],
      "properties": {
        "leaf": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entryId", "manifestDigest"],
          "properties": {
            "entryId": { "$ref": "#/$defs/entryId" },
            "manifestDigest": {
              "type": "object",
              "additionalProperties": false,
              "required": ["algorithm", "value"],
              "properties": {
                "algorithm": { "const": "sha-256" },
                "value": { "$ref": "#/$defs/sha256" }
              }
            }
          }
        },
        "leafHash": { "$ref": "#/$defs/sha256" },
        "leafIndex": { "type": "integer", "minimum": 0, "maximum": 9999 }
      }
    },
    "entryId": {
      "type": "string",
      "pattern": "^urn:uuid:[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
